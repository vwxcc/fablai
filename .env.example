# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_POLLING=1

# Comma-separated numeric Telegram user IDs. These are the only Telegram admins.
ADMIN_TELEGRAM_IDS=
ADMIN_PASSWORD=

# Use a random secret of at least 32 characters. Never commit a real value.
APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# PostgreSQL is recommended for deployment. SQLite is for local development.
DATABASE_URL=sqlite+aiosqlite:///./data/fablai.db

# Default per-user allowance: 1,000,000 tokens in a rolling 12-hour window.
USER_TOKEN_LIMIT=1000000
USER_LIMIT_WINDOW_SECONDS=43200

# Agent guardrails
AGENT_MAX_STEPS=80
AGENT_MAX_RUNTIME_SECONDS=900
AGENT_MAX_TOOL_RESULT_CHARS=20000
AGENT_MAX_PARALLEL_TOOLS=5

# Temporary uploads only. Files are deleted when the request ends.
TEMP_UPLOAD_ROOT=/tmp/fablai-requests
MAX_UPLOAD_BYTES=20971520
MAX_FETCH_BYTES=1500000
